{
  "name": "trading-demo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@drasi/react": "file:../../../dev-tools/react",
    "@radix-ui/react-tabs": "1.1.13",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "^10.4.0",
    "jsdom": "26.1.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "tsx": "4.20.6",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "3.2.7"
  },
  "scripts": {
    "drasi-react:prepare": "npm --prefix ../../../dev-tools/react install --ignore-scripts --prefer-offline && npm --prefix ../../../dev-tools/react run build",
    "predev": "npm run drasi-react:prepare",
    "dev": "vite",
    "prebuild": "npm run drasi-react:prepare",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rm -rf node_modules dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run && node --test test/tools/metrics-policy.test.mjs test/tools/contrast-provenance.test.mjs",
    "test:coverage": "vitest run --coverage && node --test test/tools/metrics-policy.test.mjs test/tools/contrast-provenance.test.mjs",
    "test:browser": "vite build --config test/browser/consumer/vite.config.ts && playwright test",
    "test:browser:linux": "node test/tools/linux-browser.mjs",
    "test:browser:update": "node test/tools/linux-browser.mjs --project=visual --update-snapshots",
    "test:live": "node --import tsx test/live/run.ts"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
