        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "drasi-prometheus"
          },
          "expr": "process_max_fds",
          "legendFormat": "max (soft limit)",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "stat",
      "id": 13,
      "title": "Uptime",
      "description": "time() - process_start_time_seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "drasi-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
