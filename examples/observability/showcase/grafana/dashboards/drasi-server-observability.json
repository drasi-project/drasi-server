{
  "uid": "drasi-server-observability",
  "title": "Drasi Server observability",
  "description": "Drasi pipeline metrics, Server process metrics and Jaeger traces for examples/observability (demo.sh showcase).",
  "tags": [
    "drasi",
    "observability"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "trace_id",
        "label": "Trace ID (from Jaeger)",
        "description": "Paste a trace ID from the Jaeger UI to show that trace in the Traces row.",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Drasi pipeline",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Source events dispatched",
      "description": "Changes the HTTP source dispatched into the graph, per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "drasi-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:/s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drasi-prometheus"
          },
          "expr": "sum(rate(drasi_source_events_dispatched[$__rate_interval]))",
          "legendFormat": "source events/s",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Query events processed",
      "description": "Source changes the native query processed, per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "drasi-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:/s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drasi-prometheus"
          },
          "expr": "sum(rate(drasi_query_events_processed[$__rate_interval]))",
          "legendFormat": "query events/s",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Query results emitted",
      "description": "Result changes the query emitted, per second, by change kind.",
      "datasource": {
        "type": "prometheus",
        "uid": "drasi-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:/s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drasi-prometheus"
          },
          "expr": "sum by (change_kind) (rate(drasi_query_results_emitted[$__rate_interval]))",
          "legendFormat": "{{change_kind}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Reaction results and deliveries",
      "description": "drasi_reaction_results_processed counts results a reaction reports through Core's reaction worker; the log reaction used here does not, so it stays 0. The graph's deliveries to the reaction (sink.handle, drasi_component_inputs_processed for the sink) show the results reaching it.",
      "datasource": {
        "type": "prometheus",
        "uid": "drasi-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:/s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drasi-prometheus"
          },
          "expr": "sum(rate(drasi_reaction_results_processed[$__rate_interval]))",
          "legendFormat": "reaction results processed/s",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "drasi-prometheus"
          },
          "expr": "sum(rate(drasi_component_inputs_processed{component_kind=\"sink\",completion=\"handled\"}[$__rate_interval]))",
          "legendFormat": "deliveries to the reaction/s",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Query engine duration",
      "description": "p50 and p95 of the evaluator histogram drasi_query_engine_duration (seconds).",
      "datasource": {
        "type": "prometheus",
        "uid": "drasi-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drasi-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(drasi_query_engine_duration_bucket{phase=\"steady\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "drasi-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(drasi_query_engine_duration_bucket{phase=\"steady\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Queue depth",
      "description": "Pending items across the graph's physical queues, and the deepest any queue has been.",
      "datasource": {
        "type": "prometheus",
        "uid": "drasi-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drasi-prometheus"
          },
          "expr": "sum(drasi_queue_depth)",
          "legendFormat": "pending (all queues)",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "drasi-prometheus"
          },
          "expr": "max(drasi_queue_depth_max)",
          "legendFormat": "peak (deepest queue)",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "row",
      "id": 8,
      "title": "Server process (whole drasi-server process)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "CPU",
      "description": "rate(process_cpu_seconds_total[1m]) * 100: percent of one CPU core.",
      "datasource": {
        "type": "prometheus",
        "uid": "drasi-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drasi-prometheus"
          },
          "expr": "rate(process_cpu_seconds_total[1m]) * 100",
          "legendFormat": "CPU % of one core",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Resident memory",
      "description": "process_resident_memory_bytes.",
      "datasource": {
        "type": "prometheus",
        "uid": "drasi-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drasi-prometheus"
          },
          "expr": "process_resident_memory_bytes",
          "legendFormat": "resident memory",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Threads",
      "description": "process_threads.",
      "datasource": {
        "type": "prometheus",
        "uid": "drasi-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "drasi-prometheus"
          },
          "expr": "process_threads",
          "legendFormat": "threads",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "stat",
      "id": 12,
      "title": "File descriptors: open vs max",
      "description": "process_open_fds and the soft limit process_max_fds (omitted when unlimited).",
      "datasource": {
        "type": "prometheus",
        "uid": "drasi-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
