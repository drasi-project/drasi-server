  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1",
    "vitest": "3.2.7",
    "playwright": "^1.55.0"
  },
  "engines": { "node": "22.x || 24.x" }
