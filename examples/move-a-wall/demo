#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
example_root="$PWD"
server_root="$(cd ../.. && pwd)"
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$server_root/target}"
case "$CARGO_TARGET_DIR" in
  /*) ;;
  *) export CARGO_TARGET_DIR="$PWD/$CARGO_TARGET_DIR" ;;
esac
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-1}"
export CARGO_PROFILE_DEV_DEBUG=0
export CARGO_PROFILE_DEV_STRIP=none
server_binary="$CARGO_TARGET_DIR/debug/drasi-server"
if [ -z "${JQ_LIB_DIR:-}" ] && command -v pkg-config >/dev/null 2>&1 && pkg-config --exists libjq; then
  export JQ_LIB_DIR="$(pkg-config --variable=libdir libjq)"
fi
case "$(uname -s)" in
  Darwin) extension=dylib ;;
  Linux) extension=so ;;
  *) echo "This launcher supports macOS and Linux." >&2; exit 1 ;;
esac
validate_config() {
  test -x "$server_binary" ||
    { echo "Run ./demo setup first." >&2; return 1; }
  "$server_binary" --config server.yaml --plugins-dir .build/plugins validate
}
case "${1:-help}" in
  setup)
    echo "Building the in-tree @drasi/react package..."
    (
      cd "$server_root/dev-tools/react"
      npm ci --no-audit --no-fund
    )
    echo "Building the example UI..."
    (cd ui && npm ci --install-links=false --no-audit --no-fund && npm run build)
    make -C "$server_root" build
    (
      cd "$server_root"
      cargo build --locked --manifest-path "$example_root/Cargo.toml" --features dynamic-plugin --lib
      cargo build --locked --manifest-path ../drasi-core/Cargo.toml -p drasi-computation-sink-sse --features dynamic-plugin
    )
    mkdir -p .build/plugins
    cp "$CARGO_TARGET_DIR/debug/libmove_a_wall.$extension" ".build/plugins/libdrasi_move_a_wall.$extension"
    cp "$CARGO_TARGET_DIR/debug/libdrasi_computation_sink_sse.$extension" ".build/plugins/libdrasi_computation_sink_sse.$extension"
    rm -f ".build/plugins/libdrasi_reaction_sse.$extension" ".build/plugins/libdrasi_computation_network.$extension"
    validate_config
    echo "Ready: ./demo start"
    ;;
  start)
    test -x "$server_binary" &&
      test -f ".build/plugins/libdrasi_move_a_wall.$extension" &&
      test -f ".build/plugins/libdrasi_computation_sink_sse.$extension" &&
      test -f ui/node_modules/vite/bin/vite.js &&
      test -f ui/node_modules/@drasi/react/dist/index.js ||
      { echo "Run ./demo setup first." >&2; exit 1; }
    exec node ops/run.mjs
    ;;
  validate)
    validate_config
    ;;
  test)
    cargo test --locked
    cargo fmt -- --check
    cargo clippy --locked --all-targets --features dynamic-plugin -- -D warnings
    (cd ui && npm test && npm run build)
    ;;
  check)
    exec node ops/check-live.mjs
    ;;
  browser)
    exec node ops/check-browser.mjs
    ;;
  *)
    echo "Usage: ./demo setup | start | validate | test | check | browser"
    echo "start runs stock drasi-server and Vite in the foreground. Ctrl-C stops only its children."
    ;;
esac
