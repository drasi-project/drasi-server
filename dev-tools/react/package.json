{
  "name": "@drasi/react",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Drasi clients, headless React query state, provider-free tables, and accessible modal composition with package-owned themes and reduced-motion support.",
  "license": "Apache-2.0",
  "author": "The Drasi Authors",
  "homepage": "https://github.com/drasi-project/drasi-server/tree/main/dev-tools/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drasi-project/drasi-server.git",
    "directory": "dev-tools/react"
  },
  "bugs": {
    "url": "https://github.com/drasi-project/drasi-server/issues"
  },
  "keywords": [
    "drasi",
    "react",
    "sse",
    "continuous-query",
    "change-driven",
    "data-change-processing",
    "hooks",
    "realtime"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./components": {
      "import": {
        "types": "./dist/components/index.d.ts",
        "default": "./dist/components/index.js"
      },
      "require": {
        "types": "./dist/components/index.d.cts",
        "default": "./dist/components/index.cjs"
      }
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepack": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "clsx": "^2.0.0",
    "scroll-into-view-if-needed": "3.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
